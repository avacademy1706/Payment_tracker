# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database
# Leave MONGODB_URI unset in development to auto-start an in-memory MongoDB
# (via mongodb-memory-server) so the app runs with zero external setup.
# In production, point this at a real MongoDB instance (e.g. MongoDB Atlas).
MONGODB_URI=

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=pt_token

# Seed
SEED_ADMIN_EMAIL=admin@paymenttracker.com
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=Admin User
